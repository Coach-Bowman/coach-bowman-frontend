---
import { getAppStoreReviews } from "../lib/appStoreReviews";
import countries from "i18n-iso-countries";

const reviews = await getAppStoreReviews();
const reviewSets = reviews.length > 1 ? [false, true] : [false];
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

function territoryFlag(territory: string) {
  const normalizedTerritory = territory.trim().toUpperCase();
  const alpha2 =
    normalizedTerritory.length === 2
      ? normalizedTerritory
      : normalizedTerritory === "XKS"
        ? "XK"
        : countries.alpha3ToAlpha2(normalizedTerritory);

  if (!alpha2) {
    return "🌐";
  }

  return [...alpha2]
    .map((letter) => String.fromCodePoint(127397 + letter.charCodeAt(0)))
    .join("");
}
---

{
  reviews.length > 0 && (
    <section
      class="testimonial-gradient w-full overflow-hidden py-8 text-gray-600 sm:py-10 dark:text-gray-300"
      id="testimonials"
    >
      <div class="mb-8 px-6 text-center">
        <h2 class="text-3xl font-bold text-gray-900 md:text-4xl dark:text-white">
          Trusted by Coaches Around the World
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-gray-600 dark:text-gray-300">
          Hundreds of coaches around the world trust and use the Coach Bowman
          app every day.
        </p>
      </div>

      <div
        class="review-carousel w-full overflow-x-auto"
        tabindex="0"
        aria-label="Continuously scrolling customer reviews"
        data-review-carousel
      >
        <div class="flex w-max" data-review-track>
          {reviewSets.map((isDuplicate) => (
            <div
              class="flex shrink-0 gap-6 pl-6"
              data-review-set={isDuplicate ? "duplicate" : "original"}
              aria-hidden={isDuplicate ? "true" : undefined}
            >
              {reviews.map((review) => (
                <article class="flex max-h-[24rem] w-[85vw] flex-none self-start flex-col rounded-3xl border border-gray-100 bg-white p-6 shadow-xl shadow-gray-600/10 sm:w-96 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none">
                  <div class="flex items-center justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-3">
                      <div
                        class="flex shrink-0 gap-0.5 text-amber-500"
                        aria-label={`${review.rating} out of 5 stars`}
                      >
                        {Array.from({ length: 5 }, (_, index) => (
                          <svg
                            class="h-5 w-5"
                            viewBox="0 0 24 24"
                            fill={
                              index < review.rating ? "currentColor" : "white"
                            }
                            stroke="currentColor"
                            stroke-width="1.75"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="m11.48 3.5 2.2 4.46a.58.58 0 0 0 .44.32l4.92.72c.48.07.68.67.33 1.01l-3.56 3.47a.58.58 0 0 0-.17.52l.84 4.9c.08.48-.42.85-.85.62l-4.4-2.31a.58.58 0 0 0-.54 0l-4.4 2.31c-.43.23-.93-.14-.85-.62l.84-4.9a.58.58 0 0 0-.17-.52L2.55 10c-.35-.34-.15-.94.33-1.01l4.92-.72a.58.58 0 0 0 .44-.32l2.2-4.46c.22-.44.84-.44 1.04 0Z"
                            />
                          </svg>
                        ))}
                      </div>
                      <time
                        class="truncate text-sm text-gray-500 dark:text-gray-400"
                        datetime={review.createdDate}
                      >
                        {dateFormatter.format(new Date(review.createdDate))}
                      </time>
                    </div>
                    <span
                      class="text-2xl"
                      role="img"
                      aria-label={
                        review.territory
                          ? `Review from ${review.territory}`
                          : "Review territory unavailable"
                      }
                      title={review.territory || "Territory unavailable"}
                    >
                      {territoryFlag(review.territory)}
                    </span>
                  </div>

                  <h3 class="mt-3 text-lg font-semibold text-gray-800 dark:text-white">
                    {review.title}
                  </h3>

                  <div
                    class="review-body min-h-0 flex-1 overflow-y-auto pr-1 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-sky-500"
                    tabindex={isDuplicate ? "-1" : "0"}
                    aria-label="Review text and developer response"
                  >
                    {review.body && (
                      <p class="whitespace-pre-line leading-relaxed">
                        {review.body}
                      </p>
                    )}

                    {review.developerResponse && (
                      <div class="mt-4 rounded-2xl bg-sky-50 p-3 dark:bg-gray-900/60">
                        <p class="text-xs font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-400">
                          Developer response
                        </p>
                        <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-gray-700 dark:text-gray-200">
                          {review.developerResponse.body}
                        </p>
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  const carousel = document.querySelector<HTMLElement>(
    "[data-review-carousel]",
  );

  if (carousel) {
    const originalSet = carousel.querySelector<HTMLElement>(
      '[data-review-set="original"]',
    );
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const pixelsPerSecond = 95;
    let interactionPaused = false;
    let lastFrameTime = performance.now();

    const animate = (frameTime: number) => {
      const elapsedMilliseconds = Math.min(frameTime - lastFrameTime, 100);
      lastFrameTime = frameTime;

      if (
        originalSet &&
        !interactionPaused &&
        !prefersReducedMotion.matches &&
        !document.hidden
      ) {
        carousel.scrollLeft += (pixelsPerSecond * elapsedMilliseconds) / 1000;

        if (carousel.scrollLeft >= originalSet.scrollWidth) {
          carousel.scrollLeft -= originalSet.scrollWidth;
        }
      }

      window.requestAnimationFrame(animate);
    };

    carousel.addEventListener("mouseenter", () => {
      interactionPaused = true;
    });
    carousel.addEventListener("mouseleave", () => {
      interactionPaused = false;
    });
    carousel.addEventListener("focusin", () => {
      interactionPaused = true;
    });
    carousel.addEventListener("focusout", (event) => {
      if (!carousel.contains(event.relatedTarget as Node | null)) {
        interactionPaused = false;
      }
    });
    carousel.addEventListener("pointerdown", () => {
      interactionPaused = true;
    });
    window.addEventListener("pointerup", () => {
      interactionPaused = false;
    });
    window.requestAnimationFrame(animate);
  }
</script>

<style>
  .testimonial-gradient {
    background: linear-gradient(
      to bottom,
      rgb(245 158 11 / 0) 0%,
      rgb(245 158 11 / 0.2) 28%,
      rgb(245 158 11 / 0.2) 72%,
      rgb(245 158 11 / 0) 100%
    );
  }

  .review-carousel {
    scrollbar-width: none;
  }

  .review-carousel::-webkit-scrollbar {
    display: none;
  }

  .review-body {
    scrollbar-color: rgb(14 165 233 / 0.55) transparent;
    scrollbar-width: thin;
  }
</style>
