---
import Container from "./Container.astro";
import { getAppStoreReviews } from "../lib/appStoreReviews";

const reviews = await getAppStoreReviews();
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

{
  reviews.length > 0 && (
    <section class="text-gray-600 dark:text-gray-300" id="testimonials">
      <Container>
        <div class="mb-12 space-y-4 px-6 text-center md:px-0">
          <p class="text-sm font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">
            App Store reviews
          </p>
          <h2 class="text-2xl font-bold text-gray-800 dark:text-white md:text-4xl">
            Coaches and athletes love Coach Bowman.
          </h2>
          <p class="mx-auto max-w-2xl text-gray-600 dark:text-gray-300">
            Every four- and five-star review, shown newest first.
          </p>
        </div>

        <div class="gap-8 space-y-8 md:columns-2 lg:columns-3">
          {reviews.map((review) => (
            <article class="mb-8 break-inside-avoid rounded-3xl border border-gray-100 bg-white p-8 shadow-2xl shadow-gray-600/10 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none">
              <div
                class="text-lg tracking-wider text-amber-500"
                aria-label={`${review.rating} out of 5 stars`}
              >
                <span aria-hidden="true">{"★".repeat(review.rating)}</span>
              </div>

              <h3 class="mt-4 text-lg font-semibold text-gray-800 dark:text-white">
                {review.title}
              </h3>

              {review.body && (
                <p class="mt-3 whitespace-pre-line leading-relaxed">
                  {review.body}
                </p>
              )}

              <footer class="mt-6 border-t border-gray-100 pt-4 text-sm dark:border-gray-700">
                <p class="font-medium text-gray-700 dark:text-gray-200">
                  {review.reviewerNickname}
                </p>
                <p class="mt-1 text-gray-500 dark:text-gray-400">
                  <time datetime={review.createdDate}>
                    {dateFormatter.format(new Date(review.createdDate))}
                  </time>
                  {review.territory && ` · ${review.territory}`}
                </p>
              </footer>
            </article>
          ))}
        </div>
      </Container>
    </section>
  )
}
